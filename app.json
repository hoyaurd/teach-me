{
  "expo": {
    "name": "Teach-Me",
    "slug": "Teach-Me",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icone-bouton-flottant.png",
    "scheme": "teachme",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.levi.teachme",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icone-bouton-flottant.png",
        "backgroundImage": "./assets/images/icone-bouton-flottant.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/icone-bouton-flottant.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/icone-bouton-flottant.png",
          "imageWidth": 76
        }
      ],
      "expo-image",
      "expo-web-browser",
      "expo-notifications",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "46ab0b68-fd58-473e-834b-98f5b998731a"
      }
    },
    "owner": "12kleuen"
  }
}
